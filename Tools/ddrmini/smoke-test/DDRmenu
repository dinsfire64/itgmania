#!/bin/sh

app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
audio_log="$app_dir/ddrmini-audio.log"
monitor_pid=

cleanup() {
  if [ -n "$monitor_pid" ]; then
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

chmod +x "$app_dir/monitor_audio.sh" "$app_dir/ddrmini-smoke"
"$app_dir/monitor_audio.sh" >>"$audio_log" 2>&1 &
monitor_pid=$!

"$app_dir/ddrmini-smoke"
status=$?
echo "ddrmini-smoke exited with status $status" >>"$audio_log"

# Firmware interprets 0 and 42 as reboot/shutdown requests.
exit 1

